# Out-of-source CMake build directories (build/, build-int/, build-w1/, ...).
build*/

# CTest test output
Testing/

# Third-party dependencies (fetched or local)
third_party/

# Test audio artifacts & logs
*.wav
*.audiolog

# Runtime Python bridge bytecode (enhancement_dump.py etc. run on every
# track load/hot-reload; never commit the cache).
__pycache__/
*.pyc
